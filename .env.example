# Development defaults. Copy to .env and replace every production secret.
POSTGRES_DB=mixora
POSTGRES_USER=mixora
POSTGRES_PASSWORD=mixora
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
API_PORT=8080

MIXORA_HTTP_ADDR=:8080
MIXORA_ENV=development
MIXORA_DATABASE_URL=postgres://mixora:mixora@127.0.0.1:5432/mixora?sslmode=disable
MIXORA_REDIS_ADDR=127.0.0.1:6379
MIXORA_PUBLIC_URL=http://127.0.0.1:5174
MIXORA_COOKIE_SECURE=false
MIXORA_SESSION_TTL=720h

MIXORA_SMTP_ADDR=127.0.0.1:1025
MIXORA_SMTP_FROM=Mixora <noreply@mixora.local>
MIXORA_SMTP_USERNAME=
MIXORA_SMTP_PASSWORD=

# Optional local recommendation profile. `make recommendations` sets the
# Docker-internal URL automatically; keep this empty for rules-v0 only.
MIXORA_GORSE_URL=
MIXORA_GORSE_API_KEY=mixora-local-gorse-key
MIXORA_GORSE_TIMEOUT=3s
GORSE_API_KEY=mixora-local-gorse-key
GORSE_PORT=8088
GORSE_DASHBOARD_USER_NAME=mixora
GORSE_DASHBOARD_PASSWORD=replace-in-production

# Optional local neural content layer. Start with `make embeddings`.
MIXORA_EMBEDDINGS_URL=
MIXORA_EMBEDDINGS_MODEL=embeddinggemma:300m-qat-q4_0
MIXORA_EMBEDDINGS_VERSION=embeddinggemma-q4-768-doc-v1
MIXORA_EMBEDDINGS_DIMENSIONS=768
MIXORA_EMBEDDINGS_TIMEOUT=2m
MIXORA_EMBEDDINGS_BATCH_SIZE=16
MIXORA_EMBEDDINGS_REQUIRED=false
OLLAMA_IMAGE=ollama/ollama:0.34.1
OLLAMA_PORT=11434
