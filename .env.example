# Development defaults. Copy to .env and replace every production secret.
MIXORA_HTTP_ADDR=:8080
MIXORA_ENV=development
MIXORA_DATABASE_URL=postgres://mixora:mixora@127.0.0.1:5432/mixora?sslmode=disable
MIXORA_REDIS_ADDR=127.0.0.1:6379
MIXORA_PUBLIC_URL=http://127.0.0.1:5174
MIXORA_COOKIE_SECURE=false
MIXORA_SESSION_TTL=720h

MIXORA_SMTP_ADDR=127.0.0.1:1025
MIXORA_SMTP_FROM=Mixora <noreply@mixora.local>
MIXORA_SMTP_USERNAME=
MIXORA_SMTP_PASSWORD=
