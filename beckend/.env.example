# Use a random hexadecimal password (safe in the database URL).
POSTGRES_PASSWORD=replace_with_random_hex_password
POSTGRES_PORT=5433
API_PORT=8080
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://mixora:replace_with_random_hex_password@127.0.0.1:5433/mixora?sslmode=disable
MEDIA_DIR=storage
ALLOWED_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
# 32 random bytes encoded as 64 hexadecimal characters, required for SoundCloud.
TOKEN_ENCRYPTION_KEY=
