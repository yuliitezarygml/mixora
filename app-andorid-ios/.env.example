# Public backend address only; NEVER add credentials or provider tokens here.
# Desktop / iOS simulator: localhost refers to this Mac.
MIXORA_API_URL=http://127.0.0.1:8080
# Android emulator: MIXORA_API_URL=http://10.0.2.2:8080
# Physical phone / release: MIXORA_API_URL=https://api.your-domain.example
# HTTP is accepted only by debug Rust builds; release requires HTTPS.
