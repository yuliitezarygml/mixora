{
  "name": "mixora-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4176 --strictPort",
    "test": "node --test src/*.test.js scripts/*.test.mjs",
    "tauri": "node scripts/toolchain.mjs",
    "native:dev": "tauri dev",
    "native:build": "tauri build",
    "android:init": "node scripts/toolchain.mjs android init",
    "android:dev": "node scripts/toolchain.mjs android dev",
    "android:build": "node scripts/toolchain.mjs android build",
    "android:apk": "node scripts/toolchain.mjs android build --debug --target aarch64 --apk --ci",
    "ios:init": "node scripts/toolchain.mjs ios init",
    "ios:dev": "node scripts/toolchain.mjs ios dev",
    "ios:build": "node scripts/toolchain.mjs ios build",
    "ios:simulator": "node scripts/toolchain.mjs ios build --debug --target aarch64-sim --no-sign --archive-only --ci"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "hls.js": "1.6.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@vitejs/plugin-react": "4.7.0",
    "vite": "7.3.6"
  }
}
